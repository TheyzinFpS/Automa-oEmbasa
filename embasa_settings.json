{
  "app": {
    "name": "EMBASA",
    "version": "1.1",
    "company_code": "EMBA"
  },
  "startup": {
    "require_sap_session": true
  },
  "security": {
    "mask_documents_in_logs": true
  },
  "cache": {
    "enabled": true,
    "persist_to_disk": true,
    "ttl_days": 30,
    "max_entries": 2000,
    "file_name": "cliente_cache.json"
  },
  "support": {
    "notification_email_enabled": false
  }
}
